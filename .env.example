# Variables para scripts/deploy-to-supabase-storage.mjs (entorno Node/CI, no el navegador).
# Copia este archivo como ".env" para uso local con una herramienta como dotenv,
# o cárgalas manualmente en tu terminal. Este repositorio no incluye un
# workflow deploy-supabase.yml; el despliegue no se ejecuta automáticamente en CI.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY
# Ejemplo sin verificar: el script usa por defecto "forge-lock-site".
# Confirma el nombre del bucket existente antes de ejecutar el script.
SUPABASE_BUCKET=forgelock-site
