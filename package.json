{
  "name": "forgelock-mvc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page de ForgeLock con arquitectura MVC en JavaScript vanilla.",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "build:dist": "vite build",
    "build:cloudflare": "vite build --outDir dist-cloudflare",
    "build:dist:cloudflare": "npm run build:cloudflare",
    "test": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.0.0",
    "serve": "14.2.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "4.155.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "compression": "1.8.2"
  }
}
